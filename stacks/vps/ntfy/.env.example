# Public URL used by ntfy to generate links and identify the server.
NTFY_BASE_URL=https://ntfy.example.com

# ntfy is behind Caddy.
NTFY_BEHIND_PROXY=true
NTFY_PROXY_FORWARDED_HEADER=X-Forwarded-For

# Authentication and authorization.
# SQLite database containing users, passwords, ACLs and tokens.
NTFY_AUTH_FILE=/etc/ntfy/auth.db
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# Enable authentication through the web UI/API.
NTFY_ENABLE_LOGIN=true
NTFY_ENABLE_SIGNUP=false

# Persistent message cache.
NTFY_CACHE_FILE=/var/cache/ntfy/cache.db

# Optional attachment storage.
# Uncomment these if attachments are enabled.
# NTFY_ATTACHMENT_CACHE_DIR=/var/cache/ntfy/attachments
# NTFY_ATTACHMENT_FILE_SIZE_LIMIT=15M
# NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT=5G
# NTFY_ATTACHMENT_EXPIRY_DURATION=3h

# Optional Web Push.
# Generate keys with:
#   docker exec -it ntfy ntfy webpush keys
#
# NTFY_WEB_PUSH_PUBLIC_KEY=
# NTFY_WEB_PUSH_PRIVATE_KEY=
# NTFY_WEB_PUSH_FILE=/var/cache/ntfy/webpush.db
# NTFY_WEB_PUSH_EMAIL_ADDRESS=

# Logging.
NTFY_LOG_LEVEL=info
NTFY_LOG_FORMAT=text
